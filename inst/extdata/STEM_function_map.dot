digraph STEM {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.65"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#3B4A5A", fillcolor="#F7F9FB"];
  edge [color="#4F5B66", arrowsize=0.7];
  "SCSTEM_Bootstrap" [fillcolor="#F7C6C7", tooltip="SCSTEM_Bootstrap.R"];
  "SCSTEM_Estim" [fillcolor="#F7C6C7", tooltip="SCSTEM_Estim.R"];
  "SCSTEM_Infocrit" [fillcolor="#F7C6C7", tooltip="SCSTEM_Infocrit.R"];
  "STEM_Bootstrap" [fillcolor="#CFE8FF", tooltip="STEM_Bootstrap.R"];
  "STEM_Estimation" [fillcolor="#CFE8FF", tooltip="STEM_Estimation.R"];
  "STEM_Kriging" [fillcolor="#CFE8FF", tooltip="STEM_Kriging.R"];
  "STEM_Model" [fillcolor="#CFE8FF", tooltip="STEM_Model.R"];
  "STEM_Simulation" [fillcolor="#CFE8FF", tooltip="STEM_Simulation.R"];
  "SCSTEM_Bootstrap" -> "STEM_Bootstrap";
  "SCSTEM_Estim" -> "STEM_Estimation";
  "SCSTEM_Estim" -> "STEM_Model";
  "SCSTEM_Infocrit" -> "SCSTEM_Estim";
}